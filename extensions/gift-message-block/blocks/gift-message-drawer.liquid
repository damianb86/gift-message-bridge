{%- liquid
  assign drawer_enabled = true
  if block.settings.enable_drawer == false
    assign drawer_enabled = false
  endif

  assign lbl = block.settings.label | default: 'Add a gift message'
  assign ph = block.settings.placeholder | default: 'Write a birthday, thank you, wedding love, etc.'
  assign from_placeholder = block.settings.from_placeholder | default: 'From'
  assign to_placeholder = block.settings.to_placeholder | default: 'To'
  assign message_field_label = block.settings.message_field_label | default: 'Message'
  assign text_form_enabled = true
  if block.settings.enable_text_form == false
    assign text_form_enabled = false
  endif
  assign max_chars = block.settings.char_limit | default: 250
  assign save_button_label = block.settings.save_button_label | default: 'Save gift message'
  assign accent_color = block.settings.accent_color | default: '#4FAF8F'
  assign drawer_selector = block.settings.drawer_selector | default: ''
  assign drawer_placement = block.settings.drawer_placement | default: 'below_cart_items'
  assign drawer_padding_block = block.settings.drawer_padding_block | default: 0
  assign drawer_padding_inline = block.settings.drawer_padding_inline | default: 0
  assign custom_css = block.settings.custom_css | default: ''
  assign show_card_variant_choices = false
  if block.settings.show_card_variant_choices
    assign show_card_variant_choices = true
  endif
  assign card_variant_choices_style = block.settings.card_variant_choices_style | default: 'grid_3'
  assign card_variant_choices_label = block.settings.card_variant_choices_label | default: 'Choose a message card'
  assign money_currency_code = localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency
  assign width_unit = block.settings.width_unit | default: 'percent'
  assign width_value = block.settings.width_percent | default: 100 | append: '%'
  if width_unit == 'px'
    assign width_value = block.settings.width_px | default: 520 | append: 'px'
  endif
  assign render_actions = false
  if text_form_enabled or show_card_variant_choices
    assign render_actions = true
  endif

  assign raw_existing = ''
  if text_form_enabled
    assign raw_existing = cart.attributes['Gift Message'] | default: cart.attributes.gift_message | default: ''
  endif
  assign existing = raw_existing
  assign existing_sender = cart.attributes['Gift Message From'] | default: cart.attributes.gift_message_from | default: ''
  assign existing_recipient = cart.attributes['Gift Message To'] | default: cart.attributes.gift_message_to | default: ''
  if raw_existing contains 'From:' or raw_existing contains 'To:' or raw_existing contains 'Message:'
    if raw_existing contains 'From:'
      assign sender_tail = raw_existing | split: 'From:' | last
      assign existing_sender = sender_tail | split: 'To:' | first | split: 'Message:' | first | strip
    endif
    if raw_existing contains 'To:'
      assign recipient_tail = raw_existing | split: 'To:' | last
      assign existing_recipient = recipient_tail | split: 'Message:' | first | strip
    endif
    if raw_existing contains 'Message:'
      assign existing = raw_existing | split: 'Message:' | last | strip
    endif
  endif

  assign has_msg = false
  if existing != blank or existing_sender != blank or existing_recipient != blank
    assign has_msg = true
  endif
-%}

<div
  data-gmb-drawer-embed
  data-gmb-drawer-enabled="{{ drawer_enabled | json }}"
  data-gmb-drawer-selector="{{ drawer_selector | escape }}"
  data-gmb-drawer-placement="{{ drawer_placement | escape }}"
  data-gmb-drawer-padding-block="{{ drawer_padding_block }}"
  data-gmb-drawer-padding-inline="{{ drawer_padding_inline }}"
  id="gmb-drawer-embed-{{ block.id }}"
  hidden
  {{ block.shopify_attributes }}
>
  <template data-gmb-drawer-template>
    <div
      class="gmb-box gmb-box--drawer"
      data-gmb-block
      data-mode="order"
      data-cart-token="{{ cart.token }}"
      data-line-item-properties="false"
      data-card-variant-choices="{{ show_card_variant_choices | json }}"
      data-card-variant-style="{{ card_variant_choices_style | escape }}"
      data-card-variant-label="{{ card_variant_choices_label | escape }}"
      data-text-form-enabled="{{ text_form_enabled | json }}"
      data-money-currency-code="{{ money_currency_code | escape }}"
      data-manual-save="true"
      data-has-saved-message="{{ has_msg | json }}"
      id="gmb-drawer-{{ block.id }}"
      style="--gmb-block-width: {{ width_value }}; --gmb-block-accent: {{ accent_color }};"
    >
      <input
        type="checkbox"
        id="gmb-drawer-chk-{{ block.id }}"
        class="gmb-check"
        aria-controls="gmb-drawer-field-{{ block.id }}"
        aria-expanded="false"
      >
      <label for="gmb-drawer-chk-{{ block.id }}" class="gmb-toggle">
        <span class="gmb-check-ui" aria-hidden="true"></span>
        <span class="gmb-label">
          {{- lbl -}}
        </span>
      </label>

      <div
        id="gmb-drawer-field-{{ block.id }}"
        class="gmb-panel"
      >
        {%- if text_form_enabled -%}
          <div class="gmb-row">
            <input
              class="gmb-input gmb-from"
              placeholder="{{ from_placeholder | escape }}"
              aria-label="{{ from_placeholder | escape }}"
              value="{{ existing_sender | escape }}"
            >
            <input
              class="gmb-input gmb-to"
              placeholder="{{ to_placeholder | escape }}"
              aria-label="{{ to_placeholder | escape }}"
              value="{{ existing_recipient | escape }}"
            >
          </div>
          <textarea
            id="gmb-drawer-ta-{{ block.id }}"
            class="gmb-message"
            placeholder="{{ ph | escape }}"
            maxlength="{{ max_chars }}"
            rows="3"
            aria-label="{{ message_field_label | escape }}"
          >{{- existing | escape -}}</textarea>
        {%- else -%}
          <textarea
            id="gmb-drawer-ta-{{ block.id }}"
            class="gmb-message"
            maxlength="{{ max_chars }}"
            hidden
            disabled
            aria-hidden="true"
          ></textarea>
        {%- endif -%}
        <input
          type="hidden"
          class="gmb-message-id"
          value=""
          disabled
        >
        <div
          class="gmb-card-product-picker"
          data-gmb-card-products
          hidden
        ></div>

        {%- if text_form_enabled -%}
          <div class="gmb-note">
            <span class="gmb-status" aria-live="polite"></span>
            <span class="gmb-count" aria-live="polite">
              <span class="gmb-count-left">
                {{- max_chars | minus: existing.size -}}
              </span>
              <span class="gmb-count-total"> / {{ max_chars }}</span>
            </span>
          </div>
        {%- else -%}
          <div class="gmb-note" hidden>
            <span class="gmb-status" aria-live="polite"></span>
          </div>
        {%- endif -%}

        {%- if render_actions -%}
          <div class="gmb-actions">
            <button type="button" class="gmb-save-button">
              {{- save_button_label -}}
            </button>
            {%- if text_form_enabled -%}
              <button
                type="button"
                class="gmb-remove-button"
                {%- unless has_msg %} hidden{%- endunless -%}
              >
                Remove
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if text_form_enabled -%}
        <div
          class="gmb-saved-summary"
          data-gmb-saved-summary
          {%- unless has_msg %} hidden{%- endunless -%}
        >
          <span class="gmb-saved-dot" aria-hidden="true"></span>
          <span class="gmb-saved-text">Gift message saved</span>
          <button type="button" class="gmb-edit-button">Edit</button>
          <button type="button" class="gmb-summary-remove-button">Remove</button>
        </div>
      {%- endif -%}
    </div>
  </template>
</div>

{%- if custom_css != blank -%}
  <style>#gmb-drawer-{{ block.id }}{--gmb-custom:1;}{{ custom_css }}</style>
{%- endif -%}

<script src="{{ 'gift-message.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Gift drawer",
  "target": "body",
  "stylesheet": "gift-message.css",
  "settings": [
    {
      "type": "header",
      "content": "Cart drawer placement",
      "info": "Enable this app embed from App embeds. Gift Pulse will insert the form into the cart drawer when the theme provides one."
    },
    {
      "type": "checkbox",
      "id": "enable_drawer",
      "label": "Show gift message in cart drawer",
      "default": true
    },
    {
      "type": "text",
      "id": "drawer_selector",
      "label": "Cart drawer CSS selector",
      "info": "Optional. Use this only for custom themes when the automatic drawer detection needs a specific target.",
      "visible_if": "{{ block.settings.enable_drawer == true }}"
    },
    {
      "type": "select",
      "id": "drawer_placement",
      "label": "Placement inside drawer",
      "options": [
        { "value": "below_cart_items", "label": "Below Cart Items" },
        { "value": "above_subtotal", "label": "Above Subtotal" },
        { "value": "above_checkout", "label": "Above Checkout Button" }
      ],
      "default": "below_cart_items",
      "visible_if": "{{ block.settings.enable_drawer == true }}"
    },
    {
      "type": "range",
      "id": "drawer_padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_drawer == true }}"
    },
    {
      "type": "range",
      "id": "drawer_padding_inline",
      "label": "Horizontal padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_drawer == true }}"
    },
    {
      "type": "header",
      "content": "Gift message text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Toggle label",
      "default": "Add a gift message"
    },
    {
      "type": "checkbox",
      "id": "enable_text_form",
      "label": "Enable text message form",
      "info": "Disable this when this embed should not collect From, To, or Message text.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "placeholder",
      "label": "Message placeholder",
      "default": "Write a birthday, thank you, wedding love, etc.",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "message_field_label",
      "label": "Message field accessibility label",
      "default": "Message",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "from_placeholder",
      "label": "From placeholder",
      "default": "From",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "to_placeholder",
      "label": "To placeholder",
      "default": "To",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "range",
      "id": "char_limit",
      "label": "Character limit",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "ch",
      "default": 250,
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "save_button_label",
      "label": "Save button label",
      "default": "Save gift message",
      "visible_if": "{{ block.settings.enable_text_form == true or block.settings.show_card_variant_choices == true }}"
    },
    {
      "type": "header",
      "content": "Message card variant choices",
      "info": "Controls the paid message card variant selector shown inside the cart drawer form."
    },
    {
      "type": "checkbox",
      "id": "show_card_variant_choices",
      "label": "Show message card variant choices",
      "info": "When enabled, the drawer form shows the variants of the message card product configured in Block setup.",
      "default": false
    },
    {
      "type": "text",
      "id": "card_variant_choices_label",
      "label": "Variant selector label",
      "default": "Choose a message card",
      "visible_if": "{{ block.settings.show_card_variant_choices == true }}"
    },
    {
      "type": "select",
      "id": "card_variant_choices_style",
      "label": "Variant selector style",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown select"
        },
        {
          "value": "grid_4",
          "label": "Image grid, 4 per row"
        },
        {
          "value": "grid_3",
          "label": "Image grid, 3 per row"
        },
        {
          "value": "list_images",
          "label": "List with images"
        },
        {
          "value": "text_list",
          "label": "Text list"
        },
        {
          "value": "pills",
          "label": "Compact text buttons"
        }
      ],
      "default": "grid_3",
      "visible_if": "{{ block.settings.show_card_variant_choices == true }}"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#4FAF8F"
    },
    {
      "type": "select",
      "id": "width_unit",
      "label": "Width unit",
      "options": [
        { "value": "percent", "label": "Percent" },
        { "value": "px", "label": "Pixels" }
      ],
      "default": "percent"
    },
    {
      "type": "range",
      "id": "width_percent",
      "label": "Width percent",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_unit == 'percent' }}"
    },
    {
      "type": "range",
      "id": "width_px",
      "label": "Width pixels",
      "min": 240,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 520,
      "visible_if": "{{ block.settings.width_unit == 'px' }}"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Optional CSS applied to the drawer instance. Use .gmb-box, .gmb-panel, .gmb-input, .gmb-message, and button selectors."
    }
  ]
}
{% endschema %}
