{%- liquid
  comment
    Mode is determined automatically from the page type:
    • product page  →  line item property (submitted with the add-to-cart form)
    • any other page (cart, etc.)  →  cart attribute (saved via AJAX)
  endcomment

  if request.page_type == 'product'
    assign mode = 'product'
  else
    assign mode = 'order'
  endif

  assign enable_app_visibility_rule = true
  if block.settings.enable_app_visibility_rule == false
    assign enable_app_visibility_rule = false
  endif

  assign render_block = true
  if mode == 'product' and enable_app_visibility_rule
    assign render_block = false
    assign app_visibility_metafield_namespace = 'custom'
    assign app_visibility_metafield_key = 'show_gift_message'
    assign app_visibility_metafield_value = product.metafields[app_visibility_metafield_namespace][app_visibility_metafield_key].value

    if app_visibility_metafield_value == true or app_visibility_metafield_value == 'true'
      assign render_block = true
    endif

    if render_block == false
      for collection in product.collections
        assign collection_visibility_metafield_value = collection.metafields[app_visibility_metafield_namespace][app_visibility_metafield_key].value

        if collection_visibility_metafield_value == true or collection_visibility_metafield_value == 'true'
          assign render_block = true
          break
        endif
      endfor
    endif
  endif

  assign lbl       = block.settings.label       | default: 'Add a gift message'
  assign ph        = block.settings.placeholder | default: 'Write a birthday, thank you, wedding love, etc.'
  assign from_placeholder = block.settings.from_placeholder | default: 'From'
  assign to_placeholder = block.settings.to_placeholder | default: 'To'
  assign message_field_label = block.settings.message_field_label | default: 'Message'
  assign text_form_enabled = true
  if block.settings.enable_text_form == false
    assign text_form_enabled = false
  endif
  assign max_chars = block.settings.char_limit  | default: 250
  assign preset    = block.settings.preset      | default: 'default'
  assign custom_css = block.settings.custom_css | default: ''
  assign save_button_label = block.settings.save_button_label | default: 'Save gift message'
  assign accent_color = block.settings.accent_color | default: '#4FAF8F'
  assign write_line_item_properties = true
  if block.settings.write_line_item_properties == false
    assign write_line_item_properties = false
  endif
  assign show_card_variant_choices = true
  if block.settings.show_card_variant_choices == false
    assign show_card_variant_choices = false
  endif
  assign card_variant_choices_style = block.settings.card_variant_choices_style | default: 'grid_4'
  assign card_variant_choices_label = block.settings.card_variant_choices_label | default: 'Choose a message card'
  assign money_currency_code = localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency
  assign manual_save = false
  if text_form_enabled == false
    assign manual_save = false
  elsif mode == 'order' or block.settings.enable_save_button
    assign manual_save = true
  endif
  assign width_unit = block.settings.width_unit | default: 'percent'
  assign width_value = block.settings.width_percent | default: 100 | append: '%'
  if width_unit == 'px'
    assign width_value = block.settings.width_px | default: 520 | append: 'px'
  endif

  if mode == 'order' and text_form_enabled
    assign raw_existing = cart.attributes['Gift Message'] | default: cart.attributes.gift_message | default: ''
    assign existing = raw_existing
    assign existing_sender = cart.attributes['Gift Message From'] | default: cart.attributes.gift_message_from | default: ''
    assign existing_recipient = cart.attributes['Gift Message To'] | default: cart.attributes.gift_message_to | default: ''
    if raw_existing contains 'From:' or raw_existing contains 'To:' or raw_existing contains 'Message:'
      if raw_existing contains 'From:'
        assign sender_tail = raw_existing | split: 'From:' | last
        assign existing_sender = sender_tail | split: 'To:' | first | split: 'Message:' | first | strip
      endif
      if raw_existing contains 'To:'
        assign recipient_tail = raw_existing | split: 'To:' | last
        assign existing_recipient = recipient_tail | split: 'Message:' | first | strip
      endif
      if raw_existing contains 'Message:'
        assign existing = raw_existing | split: 'Message:' | last | strip
      endif
    endif
    assign has_msg  = false
    if existing != blank or existing_sender != blank or existing_recipient != blank
      assign has_msg = true
    endif
  else
    assign has_msg  = false
    assign existing = ''
    assign existing_sender = ''
    assign existing_recipient = ''
  endif

  assign starts_open = has_msg
  if manual_save and has_msg
    assign starts_open = false
  endif
-%}

{%- if render_block -%}

<div
  class="gmb-box"
  data-gmb-block
  data-mode="{{ mode }}"
  data-cart-token="{{ cart.token }}"
  data-line-item-properties="{{ write_line_item_properties | json }}"
  data-card-variant-choices="{{ show_card_variant_choices | json }}"
  data-card-variant-style="{{ card_variant_choices_style | escape }}"
  data-card-variant-label="{{ card_variant_choices_label | escape }}"
  data-text-form-enabled="{{ text_form_enabled | json }}"
  data-money-currency-code="{{ money_currency_code | escape }}"
  data-manual-save="{{ manual_save | json }}"
  data-has-saved-message="{{ has_msg | json }}"
  data-product-id="{% if mode == 'product' %}{{ product.id }}{% endif %}"
  data-product-title="{% if mode == 'product' %}{{ product.title | escape }}{% endif %}"
  data-product-handle="{% if mode == 'product' %}{{ product.handle | escape }}{% endif %}"
  id="gmb-{{ block.id }}"
  style="--gmb-block-width: {{ width_value }}; --gmb-block-accent: {{ accent_color }};"
  {{ block.shopify_attributes }}
>
  {%- comment -%} ── Toggle ──────────────────────────────────────────────── {%- endcomment -%}
  <input
    type="checkbox"
    id="gmb-chk-{{ block.id }}"
    class="gmb-check"
    aria-controls="gmb-field-{{ block.id }}"
    aria-expanded="{{ starts_open | json }}"
    {%- if starts_open %} checked{%- endif -%}
  >
  <label for="gmb-chk-{{ block.id }}" class="gmb-toggle">
    <span class="gmb-check-ui" aria-hidden="true"></span>
    <span class="gmb-label">
      {{- lbl -}}
    </span>
  </label>

  {%- comment -%} ── Collapsible field ────────────────────────────────────── {%- endcomment -%}
  <div
    id="gmb-field-{{ block.id }}"
    class="gmb-panel"
    {%- if starts_open %} data-gmb-open="true"{%- endif -%}
  >
    {%- if mode == 'product' -%}
      {%- comment -%}
        Product page: JS can mirror these fields into the add-to-cart form as
        line item properties, even when this app section is outside the form.
      {%- endcomment -%}
      {%- if text_form_enabled -%}
        <div class="gmb-row">
          <input
            class="gmb-input gmb-from"
            placeholder="{{ from_placeholder | escape }}"
            aria-label="{{ from_placeholder | escape }}"
          >
          <input
            class="gmb-input gmb-to"
            placeholder="{{ to_placeholder | escape }}"
            aria-label="{{ to_placeholder | escape }}"
          >
        </div>
        <textarea
          id="gmb-ta-{{ block.id }}"
          class="gmb-message"
          placeholder="{{ ph | escape }}"
          maxlength="{{ max_chars }}"
          rows="3"
          aria-label="{{ message_field_label | escape }}"
        ></textarea>
      {%- else -%}
        <textarea
          id="gmb-ta-{{ block.id }}"
          class="gmb-message"
          maxlength="{{ max_chars }}"
          hidden
          disabled
          aria-hidden="true"
        ></textarea>
      {%- endif -%}
      <input
        type="hidden"
        class="gmb-message-id"
        value=""
        disabled
      >
      <div
        class="gmb-card-product-picker"
        data-gmb-card-products
        hidden
      ></div>
      <script type="application/json" class="gmb-variants-json">
        {{- product.variants | json -}}
      </script>

    {%- else -%}
      {%- comment -%}
        Cart / other pages: no name attribute – the value is saved to
        cart.attributes via /apps/gift-message (app proxy) by gift-message.js.
        Pre-filled from Liquid on page load.
      {%- endcomment -%}
      {%- if text_form_enabled -%}
        <div class="gmb-row">
          <input
            class="gmb-input gmb-from"
            placeholder="{{ from_placeholder | escape }}"
            aria-label="{{ from_placeholder | escape }}"
            value="{{ existing_sender | escape }}"
          >
          <input
            class="gmb-input gmb-to"
            placeholder="{{ to_placeholder | escape }}"
            aria-label="{{ to_placeholder | escape }}"
            value="{{ existing_recipient | escape }}"
          >
        </div>
        <textarea
          id="gmb-ta-{{ block.id }}"
          class="gmb-message"
          placeholder="{{ ph | escape }}"
          maxlength="{{ max_chars }}"
          rows="3"
          aria-label="{{ message_field_label | escape }}"
        >{{- existing | escape -}}</textarea>
      {%- else -%}
        <textarea
          id="gmb-ta-{{ block.id }}"
          class="gmb-message"
          maxlength="{{ max_chars }}"
          hidden
          disabled
          aria-hidden="true"
        ></textarea>
      {%- endif -%}

    {%- endif -%}

    {%- if text_form_enabled -%}
      <div class="gmb-note">
        <span class="gmb-status" aria-live="polite"></span>
        <span class="gmb-count" aria-live="polite">
          <span class="gmb-count-left">
            {{- max_chars | minus: existing.size -}}
          </span>
          <span class="gmb-count-total"> / {{ max_chars }}</span>
        </span>
      </div>
    {%- else -%}
      <div class="gmb-note" hidden>
        <span class="gmb-status" aria-live="polite"></span>
      </div>
    {%- endif -%}

    {%- if manual_save -%}
      <div class="gmb-actions">
        <button type="button" class="gmb-save-button">
          {{- save_button_label -}}
        </button>
        <button
          type="button"
          class="gmb-remove-button"
          {%- unless has_msg %} hidden{%- endunless -%}
        >
          Remove
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- if manual_save -%}
    <div
      class="gmb-saved-summary"
      data-gmb-saved-summary
      {%- unless has_msg %} hidden{%- endunless -%}
    >
      <span class="gmb-saved-dot" aria-hidden="true"></span>
      <span class="gmb-saved-text">Gift message saved</span>
      <button type="button" class="gmb-edit-button">Edit</button>
      <button type="button" class="gmb-summary-remove-button">Remove</button>
    </div>
  {%- endif -%}
</div>

{%- comment -%} ── Style preset ────────────────────────────────────────── {%- endcomment -%}
{%- unless preset == 'default' -%}
<style>
{%- case preset -%}

  {%- when 'rounded' -%}
  /* Rounded — pill inputs, soft container */
  #gmb-{{ block.id }}{--gmb-block-label-color:#334155;--gmb-block-panel-bg:#fff;--gmb-block-panel-border:color-mix(in srgb,var(--gmb-block-primary) 34%,transparent);--gmb-block-field-bg:#fff;--gmb-block-field-border:color-mix(in srgb,var(--gmb-block-primary) 46%,transparent);--gmb-block-field-text:#263848;--gmb-block-placeholder:#7b8794;border:1px solid color-mix(in srgb,var(--gmb-block-primary) 44%,transparent);border-radius:1.25rem;padding:1rem 1.125rem;}
  #gmb-{{ block.id }} .gmb-panel{border-radius:1rem;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border-radius:.8rem;}
  #gmb-{{ block.id }} .gmb-check-ui{border-radius:.4rem;}

  {%- when 'minimal' -%}
  /* Minimal — underline only, no box */
  #gmb-{{ block.id }}{--gmb-block-label-color:currentColor;--gmb-block-panel-bg:transparent;--gmb-block-panel-border:transparent;--gmb-block-field-bg:transparent;--gmb-block-field-border:currentColor;--gmb-block-field-text:currentColor;--gmb-block-placeholder:#7b8794;--gmb-block-note:#64748b;}
  #gmb-{{ block.id }} .gmb-panel{padding:.65rem 0 0;border-radius:0;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border:none;border-bottom:1px solid currentColor;border-radius:0;padding-left:0;padding-right:0;resize:none;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus{box-shadow:none;border-bottom-width:2px;opacity:1;}

  {%- when 'card' -%}
  /* Card — elevated card with shadow */
  #gmb-{{ block.id }}{--gmb-block-label-color:#243447;--gmb-block-panel-bg:#f8fbfa;--gmb-block-panel-border:rgba(51,65,85,.1);--gmb-block-field-bg:#fff;--gmb-block-field-border:rgba(51,65,85,.16);--gmb-block-field-text:#1f2937;--gmb-block-placeholder:#7b8794;border:1px solid rgba(51,65,85,.1);border-radius:.75rem;box-shadow:0 10px 28px rgba(51,65,85,.1);padding:1.125rem;}
  #gmb-{{ block.id }} .gmb-panel{box-shadow:inset 0 1px 0 rgba(255,255,255,.72);}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border-radius:.5rem;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus{background:#fff;border-color:var(--gmb-block-primary);}

  {%- when 'accent' -%}
  /* Accent — bold left border, square inputs */
  #gmb-{{ block.id }}{--gmb-block-label-color:#263848;--gmb-block-panel-bg:transparent;--gmb-block-panel-border:color-mix(in srgb,var(--gmb-block-primary) 32%,transparent);--gmb-block-field-bg:#fff;--gmb-block-field-border:color-mix(in srgb,var(--gmb-block-primary) 46%,transparent);--gmb-block-field-text:#243447;--gmb-block-placeholder:#718096;border-left:3px solid var(--gmb-block-primary);padding-left:1rem;}
  #gmb-{{ block.id }} .gmb-label{font-weight:700;}
  #gmb-{{ block.id }} .gmb-panel{border-left:none;border-right:none;border-radius:0;padding-left:0;padding-right:0;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border-radius:.25rem;}

  {%- when 'soft' -%}
  /* Soft — filled inputs, no visible border */
  #gmb-{{ block.id }}{--gmb-block-label-color:#263848;--gmb-block-panel-bg:rgba(255,255,255,.72);--gmb-block-panel-border:color-mix(in srgb,var(--gmb-block-primary) 26%,transparent);--gmb-block-field-bg:#fff;--gmb-block-field-border:color-mix(in srgb,var(--gmb-block-primary) 32%,transparent);--gmb-block-field-text:#263848;--gmb-block-placeholder:#718096;background:color-mix(in srgb,var(--gmb-block-primary) 10%,#fff);border:1px solid color-mix(in srgb,var(--gmb-block-primary) 34%,transparent);border-radius:.75rem;padding:1.05rem 1.125rem;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border-radius:.5rem;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus{background:#fff;box-shadow:0 0 0 3px var(--gmb-block-focus);opacity:1;}

  {%- when 'warm' -%}
  /* Warm — blush background for the block */
  #gmb-{{ block.id }}{--gmb-block-label-color:#5a2e36;--gmb-block-panel-bg:rgba(255,255,255,.72);--gmb-block-panel-border:rgba(214,106,120,.18);--gmb-block-field-bg:#fff;--gmb-block-field-border:rgba(214,106,120,.22);--gmb-block-field-text:#342f34;--gmb-block-placeholder:#8c6f75;--gmb-block-note:#7f5f66;background:#f9e7e7;border:1px solid rgba(211,95,110,.18);border-radius:.625rem;padding:1.05rem 1.125rem;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border-radius:.45rem;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus{background:#fff;}

  {%- when 'dark' -%}
  /* Dark — inverted, for dark-background sections */
  #gmb-{{ block.id }}{--gmb-block-label-color:#eef8f4;--gmb-block-panel-bg:rgba(15,23,42,.54);--gmb-block-panel-border:rgba(255,255,255,.18);--gmb-block-field-bg:#0f172a;--gmb-block-field-hover-bg:#111c33;--gmb-block-field-focus-bg:#0f172a;--gmb-block-field-border:rgba(255,255,255,.28);--gmb-block-field-text:#f8fafc;--gmb-block-placeholder:rgba(248,250,252,.62);--gmb-block-note:rgba(238,248,244,.78);background:#334155;border-radius:.625rem;color:#eef8f4;padding:1.05rem 1.125rem;}
  #gmb-{{ block.id }} .gmb-check-ui{border-color:rgba(255,255,255,.72);}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message,
  #gmb-{{ block.id }} .gmb-card-product-select{caret-color:#f8fafc;color:#f8fafc;background:#0f172a;}
  #gmb-{{ block.id }} .gmb-input:hover,
  #gmb-{{ block.id }} .gmb-message:hover,
  #gmb-{{ block.id }} .gmb-card-product-select:hover{color:#f8fafc;background:#111c33;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus,
  #gmb-{{ block.id }} .gmb-card-product-select:focus{background:#0f172a;border-color:var(--gmb-block-primary);box-shadow:0 0 0 3px var(--gmb-block-focus);color:#f8fafc;}

  {%- when 'glass' -%}
  /* Glass — frosted-glass, works over images/gradients */
  #gmb-{{ block.id }}{--gmb-block-label-color:#243447;--gmb-block-panel-bg:rgba(255,255,255,.38);--gmb-block-panel-border:rgba(255,255,255,.54);--gmb-block-field-bg:rgba(255,255,255,.78);--gmb-block-field-border:rgba(255,255,255,.72);--gmb-block-field-text:#1f2937;--gmb-block-placeholder:#657386;--gmb-block-note:#536173;background:rgba(255,255,255,.3);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.5);border-radius:.75rem;padding:1.05rem 1.125rem;box-shadow:0 12px 30px rgba(51,65,85,.12);}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{box-shadow:inset 0 1px 0 rgba(255,255,255,.55);}

  {%- when 'outlined' -%}
  /* Outlined — strong frame, editorial feel */
  #gmb-{{ block.id }}{--gmb-block-label-color:#263848;--gmb-block-panel-bg:transparent;--gmb-block-panel-border:rgba(51,65,85,.18);--gmb-block-field-bg:#fff;--gmb-block-field-border:rgba(51,65,85,.28);--gmb-block-field-text:#1f2937;--gmb-block-placeholder:#7b8794;border:2px solid var(--gmb-block-primary);border-radius:.25rem;padding:1.05rem 1.125rem;}
  #gmb-{{ block.id }} .gmb-label{font-size:1.02em;font-weight:650;}
  #gmb-{{ block.id }} .gmb-panel{border-left:none;border-right:none;border-radius:0;padding-left:0;padding-right:0;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{border-radius:.2rem;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus{border-color:var(--gmb-block-primary);}

  {%- when 'accordion' -%}
  /* Accordion — divider rows with rotating plus/minus icon */
  #gmb-{{ block.id }}{--gmb-block-label-color:#111;--gmb-block-panel-bg:transparent;--gmb-block-panel-border:transparent;--gmb-block-field-bg:transparent;--gmb-block-field-border:#d8d6d1;--gmb-block-field-text:#4f4f4f;--gmb-block-placeholder:#6b6b6b;--gmb-block-note:#6b6b6b;border-top:1px solid #e4e1dc;border-bottom:1px solid #e4e1dc;margin:.75rem 0;}
  #gmb-{{ block.id }} .gmb-toggle{align-items:center;display:flex;gap:1rem;justify-content:space-between;min-height:4rem;padding:0;width:100%;}
  #gmb-{{ block.id }} .gmb-label{color:#111;font-size:.95em;font-weight:800;letter-spacing:0;line-height:1.2;text-transform:uppercase;}
  #gmb-{{ block.id }} .gmb-check-ui{background:transparent!important;border:0;border-radius:0;color:#111;flex:0 0 1.2em;height:1.2em;margin-left:auto;order:2;width:1.2em;}
  #gmb-{{ block.id }} .gmb-check-ui::before,
  #gmb-{{ block.id }} .gmb-check-ui::after{background:currentColor;border:0;content:"";height:2px;left:50%;opacity:1;position:absolute;top:50%;transform-origin:center;width:1.05em;}
  #gmb-{{ block.id }} .gmb-check-ui::before{transform:translate(-50%,-50%);}
  #gmb-{{ block.id }} .gmb-check-ui::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .16s cubic-bezier(.2,.8,.2,1);}
  #gmb-{{ block.id }} .gmb-check:checked + .gmb-toggle .gmb-check-ui{background:transparent;border-color:transparent;}
  #gmb-{{ block.id }} .gmb-check:checked + .gmb-toggle .gmb-check-ui::after{transform:translate(-50%,-50%) rotate(180deg);}
  #gmb-{{ block.id }} .gmb-check:focus-visible + .gmb-toggle .gmb-check-ui{box-shadow:0 0 0 3px rgba(17,17,17,.12);}
  #gmb-{{ block.id }} .gmb-panel,
  #gmb-{{ block.id }} .gmb-panel[hidden]{animation:none;background:transparent;border:0;border-radius:0;display:block!important;margin:0;max-height:0;opacity:0;overflow:hidden;padding:0;pointer-events:none;transform:translateY(-.35rem);transition:max-height .24s ease,opacity .16s ease,transform .2s ease,padding .2s ease;visibility:hidden;}
  #gmb-{{ block.id }} .gmb-panel[data-gmb-open="true"],
  #gmb-{{ block.id }} .gmb-check:checked ~ .gmb-panel{max-height:44rem;opacity:1;padding:0 0 1.1rem;pointer-events:auto;transform:translateY(0);visibility:visible;}
  #gmb-{{ block.id }} .gmb-row{gap:.75rem;margin-bottom:.75rem;}
  #gmb-{{ block.id }} .gmb-input,
  #gmb-{{ block.id }} .gmb-message{background:transparent;border:1px solid #d8d6d1;border-radius:0;color:#4f4f4f;font-size:.95em;line-height:1.45;padding:.7rem 0;resize:vertical;}
  #gmb-{{ block.id }} .gmb-input{border-left:0;border-right:0;border-top:0;}
  #gmb-{{ block.id }} .gmb-message{min-height:6rem;padding:.75rem;}
  #gmb-{{ block.id }} .gmb-input:focus,
  #gmb-{{ block.id }} .gmb-message:focus{border-color:#111;box-shadow:none;}
  #gmb-{{ block.id }} .gmb-actions{border-top:1px solid #e4e1dc;padding-top:.8rem;}
  #gmb-{{ block.id }} .gmb-save-button{background:#111;border-color:#111;border-radius:0;color:#fff;}
  #gmb-{{ block.id }} .gmb-remove-button,
  #gmb-{{ block.id }} .gmb-edit-button,
  #gmb-{{ block.id }} .gmb-summary-remove-button{border-radius:0;color:#4f4f4f;}
  #gmb-{{ block.id }} .gmb-saved-summary{background:transparent;border-color:#e4e1dc;border-radius:0;}

{%- endcase -%}
</style>
{%- endunless -%}

{%- if custom_css != blank -%}
  <style>#gmb-{{ block.id }}{--gmb-custom:1;}{{ custom_css }}</style>
{%- endif -%}

<script src="{{ 'gift-message.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Gift Message",
  "target": "section",
  "stylesheet": "gift-message.css",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Toggle label",
      "default": "Add a gift message"
    },
    {
      "type": "checkbox",
      "id": "enable_text_form",
      "label": "Enable text message form",
      "info": "Disable this when shoppers should only select a paid message card variant without entering From, To, or Message text.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "placeholder",
      "label": "Message placeholder",
      "default": "Write a birthday, thank you, wedding love, etc.",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "message_field_label",
      "label": "Message field accessibility label",
      "default": "Message",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "from_placeholder",
      "label": "From placeholder",
      "default": "From",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "text",
      "id": "to_placeholder",
      "label": "To placeholder",
      "default": "To",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "range",
      "id": "char_limit",
      "label": "Character limit",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "ch",
      "default": 250,
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Used for the checkbox, save button, focus ring, selected states, and accent-driven presets.",
      "default": "#4FAF8F"
    },
    {
      "type": "checkbox",
      "id": "write_line_item_properties",
      "label": "Add product gift message to line item properties",
      "info": "Strongly recommended for product pages. Cart pages always save one order-level cart attribute named Gift Message, containing From, To, and Message in one text field.",
      "default": true
    },
    {
      "type": "header",
      "content": "Message card variant choices",
      "info": "Controls the paid printed message card variant selector shown inside the storefront form."
    },
    {
      "type": "checkbox",
      "id": "show_card_variant_choices",
      "label": "Show message card variant choices",
      "info": "When enabled, product pages show small selectable cards for the variants of the message card product configured in Block setup.",
      "default": true
    },
    {
      "type": "text",
      "id": "card_variant_choices_label",
      "label": "Variant selector label",
      "default": "Choose a message card",
      "visible_if": "{{ block.settings.show_card_variant_choices == true }}"
    },
    {
      "type": "select",
      "id": "card_variant_choices_style",
      "label": "Variant selector style",
      "options": [
        {
          "value": "dropdown",
          "label": "Dropdown select"
        },
        {
          "value": "grid_4",
          "label": "Image grid, 4 per row"
        },
        {
          "value": "grid_3",
          "label": "Image grid, 3 per row"
        },
        {
          "value": "list_images",
          "label": "List with images"
        },
        {
          "value": "text_list",
          "label": "Text list"
        },
        {
          "value": "pills",
          "label": "Compact text buttons"
        }
      ],
      "default": "grid_4",
      "visible_if": "{{ block.settings.show_card_variant_choices == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_save_button",
      "label": "Show save button on product pages",
      "info": "Cart pages always use a save button. Enable this to require the button on product pages too; the message is not saved until the customer clicks it.",
      "default": false,
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "header",
      "content": "App visibility rule",
      "info": "When enabled, Gift Pulse uses the app-managed custom.show_gift_message metafield. Only products marked true, or products in collections marked true, show this block. Manage selected products and collections in [Block setup](https://app-gift-pulse.zuam.dev/app#product-metafield-visibility)."
    },
    {
      "type": "checkbox",
      "id": "enable_app_visibility_rule",
      "label": "Use Gift Pulse visibility rule",
      "info": "Default on. Disable it only if this block should appear on every product page regardless of the app-managed product or collection selection.",
      "default": true
    },
    {
      "type": "text",
      "id": "save_button_label",
      "label": "Save button label",
      "default": "Save gift message",
      "visible_if": "{{ block.settings.enable_text_form == true }}"
    },
    {
      "type": "select",
      "id": "width_unit",
      "label": "Width unit",
      "options": [
        { "value": "percent", "label": "Percent" },
        { "value": "px", "label": "Pixels" }
      ],
      "default": "percent"
    },
    {
      "type": "range",
      "id": "width_percent",
      "label": "Width percent",
      "info": "Used when Width unit is Percent. 100% means full available width.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_unit == 'percent' }}"
    },
    {
      "type": "range",
      "id": "width_px",
      "label": "Width pixels",
      "info": "Used when Width unit is Pixels. The block still never exceeds the available container width.",
      "min": 240,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 520,
      "visible_if": "{{ block.settings.width_unit == 'px' }}"
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Style preset",
      "options": [
        { "value": "default",  "label": "Default — inherits theme styles" },
        { "value": "rounded",  "label": "Rounded — pill inputs, soft border" },
        { "value": "minimal",  "label": "Minimal — underlines only" },
        { "value": "card",     "label": "Card — elevated box with shadow" },
        { "value": "accent",   "label": "Accent — bold left border" },
        { "value": "soft",     "label": "Soft — filled inputs, no borders" },
        { "value": "warm",     "label": "Warm — blush background" },
        { "value": "dark",     "label": "Dark — inverted for dark sections" },
        { "value": "glass",    "label": "Glass — frosted glass over images" },
        { "value": "outlined", "label": "Outlined — strong frame border" },
        { "value": "accordion", "label": "Accordion — plus/minus dividers" }
      ],
      "default": "default"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS (applied on top of preset)",
      "info": "Available classes: .gmb-box, .gmb-label, .gmb-check, .gmb-check-ui, .gmb-panel, .gmb-row, .gmb-input, .gmb-message, .gmb-note, .gmb-actions, .gmb-save-button, .gmb-remove-button."
    }
  ]
}
{% endschema %}
