COMPOSE_PROJECT_NAME=gift-message-bridge-lite
SHARED_DOCKER_NETWORK=shared_apps

SHOPIFY_API_KEY=replace-with-shopify-client-id
SHOPIFY_API_SECRET=replace-with-shopify-client-secret
SHOPIFY_APP_URL=https://gift-message-bridge-lite.yourdomain.com
SCOPES=read_orders

APP_DB_NAME=gift_message_bridge_lite
APP_DB_USER=gift_message_bridge_lite
APP_DB_PASSWORD=replace-with-app-db-password
DATABASE_URL=postgresql://gift_message_bridge_lite:replace-with-app-db-password@postgres:5432/gift_message_bridge_lite?schema=public&connection_limit=3

CONTACT_EMAIL=damianbe86@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=damianbe86@gmail.com
EMAIL_PASS=---

GIFT_MESSAGE_BRIDGE_HOST=gift-message-bridge-lite.yourdomain.com
NODE_OPTIONS=--max-old-space-size=128
