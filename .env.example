COMPOSE_PROJECT_NAME=gift-message-bridge
SHARED_DOCKER_NETWORK=shared_apps

SHOPIFY_API_KEY=replace-with-shopify-client-id
SHOPIFY_API_SECRET=replace-with-shopify-client-secret
APP_HOST=app-gift-pulse.zuam.dev
SHOPIFY_APP_URL=https://app-gift-pulse.zuam.dev
SCOPES=read_orders

APP_DB_NAME=gift_message_bridge_lite
APP_DB_USER=qorve_dev
APP_DB_PASSWORD=replace-with-app-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qorve_dev:replace-with-app-db-password@127.0.0.1:5432/gift_message_bridge_lite?schema=public

# Docker Compose override:
# DATABASE_URL=postgresql://gift_message_bridge_lite:replace-with-app-db-password@postgres:5432/gift_message_bridge_lite?schema=public&connection_limit=3

# Cloudflare Email Routing receives contact@zuam.dev and forwards it to Gmail.
# Outbound app email should use Resend SMTP from the verified zuam.dev domain.
CONTACT_EMAIL=contact@zuam.dev
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=resend
EMAIL_PASS=
EMAIL_FROM=noreply@zuam.dev
EMAIL_FROM_NAME="Zuam Gift Pulse"
EMAIL_REPLY_TO=contact@zuam.dev

NODE_OPTIONS=--max-old-space-size=128
